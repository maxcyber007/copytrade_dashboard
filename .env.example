# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. NEVER commit .env
# ---------------------------------------------------------------------------

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# ---------------------------------------------------------------------------
# Deployment topology
#
# Leave everything in this block at its default to run the whole platform as
# one process, which is what a local install and a single-host deployment do.
#
# Fill it in to split the frontend from the backend: the landing site and the
# dashboard hosted somewhere with no database, and the API, worker, queues and
# database kept on your own machine. See DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# Where a member's browser goes — the address that belongs in an email. APP_URL
# is this deployment's own address, which on a split backend is the API and not
# somewhere a person can open. Required when APP_ROLE=api; defaults to APP_URL
# otherwise, so a single-host install needs nothing.
PUBLIC_APP_URL=

# all      one process serves pages and API (default)
# api      backend only: API routes, worker, database, queues
# frontend pages only; holds no secrets and opens no database connection
APP_ROLE=all

# Where server-rendered pages reach the API. Defaults to APP_URL, so a
# single-host install calls itself. On a split frontend this is the API's
# public URL, e.g. https://api.trendxsynex.com
API_BASE_URL=

# Where the *browser* reaches the API. Must be set at build time to reach client
# code. Empty means same-origin, which is what a single-host install wants.
NEXT_PUBLIC_API_BASE_URL=

# Backend to forward /api/* to, set on the FRONTEND deployment only. With this
# set the browser only ever addresses the frontend, so the request is
# same-origin and the session is a first-party cookie — which is what makes
# sign-in work in Safari, where a third-party cookie is refused outright.
# Unnecessary once the frontend and API are subdomains of one domain.
# Read at BUILD time: it is compiled into the route manifest.
API_PROXY_TARGET=

# Browser origins allowed to call the API with credentials, comma-separated and
# matched exactly. Required when APP_ROLE=api. There is no wildcard: a
# credentialed cross-origin request must name its origin.
# e.g. https://trendxsynex.com,https://app.trendxsynex.com
ALLOWED_ORIGINS=

# Domain the session cookie is issued for, so that `app.` and `api.` on the same
# domain share one session. Leave empty on a single host — that yields a
# host-only cookie, which is the tighter of the two.
# e.g. .trendxsynex.com
SESSION_COOKIE_DOMAIN=

# `lax` is correct while the frontend and API are subdomains of one registrable
# domain: browsers count those as same-site, so the cookie is still sent. Only a
# genuinely cross-site frontend (a *.vercel.app preview URL) needs `none`, and
# `none` requires HTTPS.
SESSION_COOKIE_SAMESITE=lax

# The two frontend hostnames, when the marketing site and the dashboard are
# split across domains. Setting both makes each domain redirect the other's
# paths, so no page is reachable at two addresses. Leave empty to serve
# everything from one hostname.
NEXT_PUBLIC_LANDING_HOST=
NEXT_PUBLIC_DASHBOARD_HOST=

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://copytrade:copytrade@localhost:5432/copytrade?schema=public

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379

# --- Authentication ---
# openssl rand -base64 48
AUTH_SECRET=
# Session lifetime in seconds (default 7 days)
SESSION_TTL_SECONDS=604800

# --- Encryption of trading account credentials (AES-256-GCM) ---
# Must be 32 bytes, base64 encoded:  openssl rand -base64 32
ENCRYPTION_KEY=

# --- Trading provider selection: mock | metaapi ---
# One provider serves both MT4 and MT5; each account stores its own platform.
TRADING_PROVIDER=mock
METAAPI_TOKEN=
# Region for accounts this platform creates. An account that already exists in
# MetaApi keeps its own region and is reached wherever it lives.
METAAPI_REGION=new-york
# cloud-g2 is MetaApi's default (faster, cheaper); high reliability is a paid option.
METAAPI_ACCOUNT_TYPE=cloud-g2
METAAPI_RELIABILITY=regular
# Admin dashboard warns when the MetaApi balance or its measured runway drops
# below these. MetaApi is prepaid: when the credit runs out it stops serving
# accounts, so the warning has to come well before zero.
METAAPI_LOW_BALANCE=20
METAAPI_LOW_RUNWAY_DAYS=7

# --- Master EA -> Trade Event API authentication ---
# openssl rand -hex 16  /  openssl rand -hex 32
MASTER_API_KEY=
MASTER_API_SECRET=
# Max allowed clock skew for signed master events (seconds)
MASTER_EVENT_MAX_SKEW_SECONDS=60

# --- Payment provider: mock | stripe | omise ---
PAYMENT_PROVIDER=mock

# --- Email: console | smtp ---
# console writes messages to the log and is refused in production, because a
# password reset link must not live in a log file.
EMAIL_PROVIDER=console
EMAIL_FROM="CopyTrade Cloud <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
PASSWORD_RESET_TTL_MINUTES=30

# --- Background jobs ---
# How often connected accounts are reconciled with the broker, and how often
# strategy statistics are recomputed.
SYNC_INTERVAL_SECONDS=60
STATS_INTERVAL_SECONDS=300
# How often a watched master account is polled — the delay a follower sees.
MASTER_WATCH_SECONDS=15

# --- Logging ---
LOG_LEVEL=info

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
