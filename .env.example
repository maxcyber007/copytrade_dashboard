# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. NEVER commit .env
# ---------------------------------------------------------------------------

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://copytrade:copytrade@localhost:5432/copytrade?schema=public

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379

# --- Authentication ---
# openssl rand -base64 48
AUTH_SECRET=
# Session lifetime in seconds (default 7 days)
SESSION_TTL_SECONDS=604800

# --- Encryption of trading account credentials (AES-256-GCM) ---
# Must be 32 bytes, base64 encoded:  openssl rand -base64 32
ENCRYPTION_KEY=

# --- Trading provider selection: mock | metaapi ---
# One provider serves both MT4 and MT5; each account stores its own platform.
TRADING_PROVIDER=mock
METAAPI_TOKEN=
# Region for accounts this platform creates. An account that already exists in
# MetaApi keeps its own region and is reached wherever it lives.
METAAPI_REGION=new-york
# cloud-g2 is MetaApi's default (faster, cheaper); high reliability is a paid option.
METAAPI_ACCOUNT_TYPE=cloud-g2
METAAPI_RELIABILITY=regular

# --- Master EA -> Trade Event API authentication ---
# openssl rand -hex 16  /  openssl rand -hex 32
MASTER_API_KEY=
MASTER_API_SECRET=
# Max allowed clock skew for signed master events (seconds)
MASTER_EVENT_MAX_SKEW_SECONDS=60

# --- Payment provider: mock | stripe | omise ---
PAYMENT_PROVIDER=mock

# --- Email: console | smtp ---
# console writes messages to the log and is refused in production, because a
# password reset link must not live in a log file.
EMAIL_PROVIDER=console
EMAIL_FROM="CopyTrade Cloud <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
PASSWORD_RESET_TTL_MINUTES=30

# --- Background jobs ---
# How often connected accounts are reconciled with the broker, and how often
# strategy statistics are recomputed.
SYNC_INTERVAL_SECONDS=60
STATS_INTERVAL_SECONDS=300
# How often a watched master account is polled — the delay a follower sees.
MASTER_WATCH_SECONDS=15

# --- Logging ---
LOG_LEVEL=info

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
